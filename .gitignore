

# Ignore everything
#*

# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# But not these files...
!.gitignore
!.config

# ...even if they are in subdirectories
#!*/
dependencies/*
build/*
!build/linux-rpi-4.14.y-rt
!build/linux-rpi-4.14.y-rt/*
!build/linux-rpi-4.14.y-rt/.config
!build/linux-rpi-4.14.y-rt/Makefile

#build  
#host  
#images  
#!Makefile  
#scripts  
#staging  
#target
#.config.old
#.br-external.mk
#..config.tmp

#!*/build/linux-rpi-4.14.y-rt/.config
#!*/build/linux-rpi-4.14.y-rt/Makefile
workspace/
br.log

# Build outputs
output/
dl/
.config
.config.old
*.o
*.ko
*.a

# RAUC bundles
*.raucb
*.tar
*.squashfs
*.ext4

# Private keys — NEVER commit private keys
keys/**/*.pem
keys/**/*.key
keys/**/*.p12
keys/**/*-private*
!keys/**/*.pub
!keys/**/*.crt
!keys/**/README.md
!keys/**/*.sh

# Secrets
*.secret
*.env
.env.*
!.env.example

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
.copilot/
